  <tag k="colour" v="#e3a7c8"/>
  <tag k="cycle_network" v="EuroVelo"/>
  <tag k="description" v="Over a thousand years ago, pilgrims traveled all the way from England to Rome. After the Eternal City, the route continued to Jerusalem through the port of Brindisi. EuroVelo 5 is a 3,200 km version of this legendary route."/>
  <tag k="distance" v="3200"/>
